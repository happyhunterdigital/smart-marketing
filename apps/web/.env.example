NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=smart-marketing.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=smart-marketing
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=smart-marketing.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Stripe (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# WhatsApp webhook URL shown in dashboard (set after deploy)
NEXT_PUBLIC_WHATSAPP_WEBHOOK_URL=https://us-central1-smart-marketing.cloudfunctions.net/whatsappWebhook
