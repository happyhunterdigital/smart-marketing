# ============================================================
# Smart Marketing — Functions Secrets (.env.example)
# Copy to .env locally ONLY for emulator; prod uses Firebase Secrets
# firebase functions:secrets:set <KEY>
# ============================================================

# --- Meta WhatsApp Cloud API (required) ---
# From Meta App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_system_user_token_here
# alias: META_SYSTEM_TOKEN
PHONE_NUMBER_ID=your_phone_number_id_here
# You choose this — must match Meta Webhook Verify Token
VERIFY_TOKEN=your_random_verify_token_here
# Meta App → Settings → Basic → App Secret (HMAC X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your_app_secret_here
# Lead alerts / daily report
ADMIN_NUMBER=27601016673
ADMIN_WHATSAPP_NUMBER=27601016673
BASE_URL=https://happyhunterdigital.com

# --- AI (at least GEMINI_API_KEY required) ---
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
PLACES_API_KEY=your_google_places_api_key_here
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# --- CRM Relay (optional, fail-open if missing) ---
CRM_INGEST_URL=https://your-crm.example.com
CRM_INGEST_SECRET=your_crm_ingest_secret
CRM_BOT_SECRET=your_crm_bot_secret

# --- Emulator only ---
# GCLOUD_PROJECT=smart-marketing
# FIRESTORE_EMULATOR_HOST=localhost:8080
